# ========================================================
# RESUMEFLOW - RUPEEAPEX GROUPS OF COMPANIES ENVIRONMENT CONFIG
# ========================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/resumeflow

# Session Secret (Strong random key for signing cookies/JWT)
SESSION_SECRET=resumeflow_rupeeapex_super_secure_jwt_session_secret_32chars!

# Storage configuration
# Local storage path for uploaded candidate photographs (private, not in public/ folder)
STORAGE_DIR=./storage/uploads

# Initial HR Admins Setup (Used by scripts/create-admins.ts)
# Account 1
HR_ADMIN_1_USERNAME=hr.admin1
HR_ADMIN_1_PASSWORD=ChangeMeStrongPass123!

# Account 2
HR_ADMIN_2_USERNAME=hr.admin2
HR_ADMIN_2_PASSWORD=ChangeMeStrongPass456!
